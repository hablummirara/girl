---
const {
  title = "Girl Collection | Your Digital Best Friend",
  description = "Girl Collection adalah web statis katalog belanja cewek dengan checkout WhatsApp.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&family=Nunito+Sans:wght@400;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --primary: #aa2c62;
    --primary-strong: #71003a;
    --primary-soft: #ffd9e2;
    --primary-bright: #ff6fa5;
    --secondary: #6f518e;
    --secondary-soft: #efdbff;
    --surface: #fff8f8;
    --surface-low: #fff0f2;
    --surface-mid: #ffe9ed;
    --surface-high: #f9e3e7;
    --ink: #24181c;
    --muted: #604b51;
    --outline: #dcbfc6;
    --whatsapp: #25d366;
    --shadow: 0 22px 55px -30px rgba(170, 44, 98, 0.45);
    --radius: 18px;
    --container: 1180px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-width: 320px;
    background: var(--surface);
    color: var(--ink);
    font-family: "Nunito Sans", system-ui, sans-serif;
    line-height: 1.6;
  }

  body.menu-open {
    overflow: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  button {
    font: inherit;
  }

  .material-symbols-outlined {
    font-family: "Material Symbols Outlined";
    font-weight: normal;
    font-style: normal;
    font-size: 24px;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-flex;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    -webkit-font-feature-settings: "liga";
    -webkit-font-smoothing: antialiased;
    font-variation-settings: "FILL" 0, "wght" 500, "GRAD" 0, "opsz" 24;
  }

  .container {
    width: min(var(--container), calc(100% - 40px));
    margin-inline: auto;
  }

  .page {
    min-height: 100vh;
    padding-top: 88px;
  }

  .section {
    padding-block: clamp(56px, 8vw, 96px);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    border: 1px solid rgba(170, 44, 98, 0.18);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.58);
    color: var(--primary);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 0.83rem;
    font-weight: 800;
    padding: 7px 14px;
  }

  .title-xl,
  .title-lg,
  .title-md {
    margin: 0;
    font-family: "Plus Jakarta Sans", sans-serif;
    line-height: 1.12;
    letter-spacing: 0;
  }

  .title-xl {
    font-size: clamp(2.25rem, 7vw, 4.85rem);
    color: var(--primary);
  }

  .title-lg {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .title-md {
    font-size: clamp(1.45rem, 3vw, 2.15rem);
  }

  .lead {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.16rem);
  }

  .btn {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-weight: 800;
    padding: 12px 20px;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--primary-bright), var(--secondary-soft));
    color: var(--primary-strong);
    box-shadow: var(--shadow);
  }

  .btn-outline {
    border: 2px solid rgba(170, 44, 98, 0.2);
    background: rgba(255, 255, 255, 0.55);
    color: var(--primary);
  }

  .grid-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 900px) {
    .grid-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .container {
      width: min(100% - 28px, var(--container));
    }

    .page {
      padding-top: 76px;
    }

    .grid-products {
      gap: 14px;
    }

    .btn {
      width: 100%;
    }
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-10px);
    }
  }
</style>
