<div class="cart-toast" data-cart-toast role="status" aria-live="polite"></div>

<script is:inline>
  (() => {
    const key = "girl-collection-cart";
    const formatter = new Intl.NumberFormat("id-ID");
    const toast = document.querySelector("[data-cart-toast]");

    const read = () => {
      try {
        const items = JSON.parse(localStorage.getItem(key) || "[]");
        return Array.isArray(items) ? items : [];
      } catch {
        return [];
      }
    };

    const write = (items) => {
      localStorage.setItem(key, JSON.stringify(items));
      window.dispatchEvent(new CustomEvent("girl-cart-change", { detail: items }));
      updateBadges(items);
    };

    const countItems = (items = read()) => items.reduce((total, item) => total + Number(item.qty || 0), 0);
    const getTotal = (items = read()) => items.reduce((total, item) => total + Number(item.numericPrice || 0) * Number(item.qty || 0), 0);

    const updateBadges = (items = read()) => {
      const total = countItems(items);
      document.querySelectorAll("[data-cart-count]").forEach((badge) => {
        badge.textContent = String(total);
        badge.classList.toggle("is-empty", total === 0);
      });
    };

    const showToast = (message) => {
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add("show");
      window.clearTimeout(showToast.timer);
      showToast.timer = window.setTimeout(() => toast.classList.remove("show"), 1800);
    };

    const add = (product) => {
      const items = read();
      const found = items.find((item) => Number(item.id) === Number(product.id));
      if (found) {
        found.qty = Number(found.qty || 1) + 1;
      } else {
        items.push({ ...product, id: Number(product.id), numericPrice: Number(product.numericPrice), qty: 1 });
      }
      write(items);
      showToast(`${product.name} ditambahkan ke keranjang`);
    };

    const remove = (id) => {
      write(read().filter((item) => Number(item.id) !== Number(id)));
    };

    const updateQty = (id, qty) => {
      const nextQty = Math.max(1, Number(qty || 1));
      const items = read().map((item) => Number(item.id) === Number(id) ? { ...item, qty: nextQty } : item);
      write(items);
    };

    window.GirlCart = {
      add,
      remove,
      updateQty,
      items: read,
      count: countItems,
      total: getTotal,
      format: (value) => formatter.format(Number(value || 0)),
      updateBadges,
    };

    document.addEventListener("click", (event) => {
      const button = event.target.closest("[data-add-to-cart]");
      if (!button) return;
      event.preventDefault();
      add({
        id: button.dataset.id,
        name: button.dataset.name,
        price: button.dataset.price,
        numericPrice: button.dataset.numericPrice,
        category: button.dataset.category,
        img: button.dataset.img,
      });
    });

    window.addEventListener("storage", (event) => {
      if (event.key === key) updateBadges();
    });

    updateBadges();
    window.dispatchEvent(new CustomEvent("girl-cart-ready"));
  })();
</script>

<style>
  .cart-toast {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    max-width: min(320px, calc(100vw - 40px));
    border-radius: 999px;
    background: var(--primary);
    color: white;
    font-weight: 800;
    opacity: 0;
    pointer-events: none;
    padding: 12px 18px;
    transform: translateY(12px);
    transition: opacity 180ms ease, transform 180ms ease;
    box-shadow: var(--shadow);
  }

  .cart-toast.show {
    opacity: 1;
    transform: translateY(0);
  }
</style>
