---
const { product } = Astro.props;
---

<article class="product-card">
  <a class="image-link" href={`/product-detail?product=${product.id}`} aria-label={`Lihat ${product.name}`}>
    <img src={product.img} alt={product.name} loading="lazy" />
    {product.featured && <span class="badge">Best Seller</span>}
  </a>
  <div class="product-info">
    <span>{product.category}</span>
    <h3>{product.name}</h3>
    <div>
      <strong>{product.price}</strong>
      <a href={`/product-detail?product=${product.id}`} aria-label={`Beli ${product.name}`}>
        <span class="material-symbols-outlined">add_shopping_cart</span>
      </a>
    </div>
  </div>
</article>

<style>
  .product-card {
    overflow: hidden;
    border: 1px solid rgba(220, 191, 198, 0.7);
    border-radius: var(--radius);
    background: white;
    box-shadow: 0 18px 45px -38px rgba(170, 44, 98, 0.7);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .image-link {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    background: var(--surface-high);
    overflow: hidden;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .badge {
    position: absolute;
    top: 12px;
    left: 12px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.9);
    color: var(--primary);
    font-size: 0.72rem;
    font-weight: 900;
    padding: 6px 10px;
  }

  .product-info {
    padding: 15px;
  }

  .product-info > span {
    color: var(--secondary);
    font-size: 0.78rem;
    font-weight: 800;
  }

  h3 {
    min-height: 48px;
    margin: 4px 0 12px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1rem;
    line-height: 1.35;
  }

  .product-info > div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }

  strong {
    color: var(--primary);
    font-size: 1.02rem;
  }

  .product-info a {
    display: grid;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    place-items: center;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary);
  }

  @media (max-width: 520px) {
    .product-info {
      padding: 12px;
    }

    h3 {
      font-size: 0.92rem;
    }
  }
</style>
