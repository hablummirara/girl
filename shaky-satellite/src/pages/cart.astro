---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { whatsappNumber } from "../data/products";
---

<Layout title="Keranjang | Girl Collection">
  <Navbar />
  <main class="page">
    <section class="container cart">
      <div class="cart-list">
        <div class="cart-head">
          <h1 class="title-md">Keranjang Belanja</h1>
          <span><strong data-cart-page-count>0</strong> Items</span>
        </div>

        <div class="items" data-cart-items></div>

        <div class="empty-cart" data-empty-cart>
          <span class="material-symbols-outlined">shopping_bag</span>
          <h2>Keranjangmu masih kosong</h2>
          <p>Yuk pilih produk favoritmu dulu, lalu tambahkan ke keranjang.</p>
          <a class="btn btn-primary" href="/products">Mulai Belanja</a>
        </div>
      </div>

      <aside class="summary" data-cart-summary>
        <h2>Ringkasan Pesanan</h2>
        <div>
          <span>Subtotal</span>
          <strong data-subtotal>Rp 0</strong>
        </div>
        <p>Estimasi pengiriman akan diinformasikan setelah detail alamat dikirim melalui chat WhatsApp.</p>
        <div class="total">
          <span>Total</span>
          <strong data-total>Rp 0</strong>
        </div>
        <a class="btn checkout disabled" href="#" data-checkout>
          <span class="material-symbols-outlined">chat</span>
          Checkout via WhatsApp
        </a>
        <button class="clear-cart" type="button" data-clear-cart>Kosongkan Keranjang</button>
      </aside>
    </section>
  </main>
  <Footer />
</Layout>

<script define:vars={{ whatsappNumber }}>
  const itemsTarget = document.querySelector("[data-cart-items]");
  const emptyTarget = document.querySelector("[data-empty-cart]");
  const summaryTarget = document.querySelector("[data-cart-summary]");
  const countTarget = document.querySelector("[data-cart-page-count]");
  const subtotalTarget = document.querySelector("[data-subtotal]");
  const totalTarget = document.querySelector("[data-total]");
  const checkoutTarget = document.querySelector("[data-checkout]");
  const clearTarget = document.querySelector("[data-clear-cart]");

  const escapeHtml = (value) => String(value ?? "").replace(/[&<>"']/g, (char) => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    "\"": "&quot;",
    "'": "&#039;",
  }[char]));

  const renderCart = () => {
    const cart = window.GirlCart;
    if (!cart || !itemsTarget) return;

    const items = cart.items();
    const count = cart.count(items);
    const total = cart.total(items);
    const hasItems = items.length > 0;

    if (countTarget) countTarget.textContent = String(count);
    if (subtotalTarget) subtotalTarget.textContent = `Rp ${cart.format(total)}`;
    if (totalTarget) totalTarget.textContent = `Rp ${cart.format(total)}`;
    emptyTarget?.classList.toggle("show", !hasItems);
    summaryTarget?.classList.toggle("disabled", !hasItems);

    itemsTarget.innerHTML = items.map((item) => `
      <article class="cart-item">
        <img src="${escapeHtml(item.img)}" alt="${escapeHtml(item.name)}" />
        <div>
          <h2>${escapeHtml(item.name)}</h2>
          <p>${escapeHtml(item.price)}</p>
          <label>
            Qty
            <input type="number" min="1" value="${item.qty}" data-cart-qty="${item.id}" />
          </label>
        </div>
        <button type="button" data-remove-cart="${item.id}" aria-label="Hapus ${escapeHtml(item.name)}">
          <span class="material-symbols-outlined">delete</span>
        </button>
      </article>
    `).join("");

    if (checkoutTarget) {
      const lines = items.map((item) => `- ${item.name} (x${item.qty}) - Rp ${cart.format(item.numericPrice * item.qty)}`).join("\n");
      const message = `Halo Girl Collection! Aku mau checkout pesanan berikut:\n\n${lines}\n\nTotal: Rp ${cart.format(total)}\n\nMohon info langkah selanjutnya ya, terima kasih!`;
      checkoutTarget.href = hasItems ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}` : "#";
      checkoutTarget.classList.toggle("disabled", !hasItems);
      checkoutTarget.toggleAttribute("target", hasItems);
      checkoutTarget.toggleAttribute("rel", hasItems);
      if (hasItems) checkoutTarget.rel = "noreferrer";
    }
  };

  document.addEventListener("click", (event) => {
    const removeButton = event.target.closest("[data-remove-cart]");
    if (removeButton) {
      window.GirlCart?.remove(removeButton.dataset.removeCart);
      renderCart();
    }
  });

  document.addEventListener("input", (event) => {
    const qtyInput = event.target.closest("[data-cart-qty]");
    if (qtyInput) {
      window.GirlCart?.updateQty(qtyInput.dataset.cartQty, qtyInput.value);
      renderCart();
    }
  });

  clearTarget?.addEventListener("click", () => {
    localStorage.setItem("girl-collection-cart", "[]");
    window.GirlCart?.updateBadges([]);
    window.dispatchEvent(new CustomEvent("girl-cart-change", { detail: [] }));
    renderCart();
  });

  window.addEventListener("girl-cart-ready", renderCart);
  window.addEventListener("girl-cart-change", renderCart);
  renderCart();
</script>

<style>
  .cart {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 28px;
    padding-block: 42px;
  }

  .cart-list,
  .items {
    display: grid;
    gap: 16px;
  }

  .cart-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    border-bottom: 1px solid var(--outline);
    padding-bottom: 14px;
  }

  .cart-head span {
    color: var(--muted);
    font-weight: 800;
  }

  .cart-head strong {
    color: var(--primary);
  }

  .cart-item {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr) 46px;
    align-items: center;
    gap: 18px;
    border: 1px solid rgba(220, 191, 198, 0.65);
    border-radius: var(--radius);
    background: white;
    padding: 16px;
  }

  .cart-item img {
    width: 128px;
    height: 128px;
    border-radius: 16px;
    object-fit: cover;
  }

  .cart-item h2 {
    margin: 0 0 6px;
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1.12rem;
  }

  .cart-item p {
    margin: 0 0 10px;
    color: var(--primary);
    font-weight: 900;
  }

  .cart-item label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    font-weight: 800;
  }

  .cart-item input {
    width: 68px;
    min-height: 36px;
    border: 1px solid var(--outline);
    border-radius: 999px;
    padding: 6px 10px;
    text-align: center;
  }

  .cart-item button {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: var(--surface-low);
    color: var(--muted);
    cursor: pointer;
  }

  .cart-item button:hover {
    color: var(--primary);
  }

  .empty-cart {
    display: none;
    justify-items: center;
    border: 1px dashed var(--outline);
    border-radius: var(--radius);
    background: white;
    padding: 44px 24px;
    text-align: center;
  }

  .empty-cart.show {
    display: grid;
  }

  .empty-cart .material-symbols-outlined {
    color: var(--primary);
    font-size: 52px;
  }

  .empty-cart h2 {
    margin: 10px 0 4px;
    font-family: "Plus Jakarta Sans", sans-serif;
  }

  .empty-cart p {
    margin: 0 0 18px;
    color: var(--muted);
  }

  .summary {
    position: sticky;
    top: 112px;
    display: grid;
    align-self: start;
    gap: 18px;
    border: 1px solid rgba(170, 44, 98, 0.16);
    border-radius: var(--radius);
    background: white;
    box-shadow: var(--shadow);
    padding: 24px;
  }

  .summary.disabled {
    opacity: 0.72;
  }

  .summary h2 {
    margin: 0;
    font-family: "Plus Jakarta Sans", sans-serif;
  }

  .summary div {
    display: flex;
    justify-content: space-between;
    gap: 14px;
  }

  .summary p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .total {
    border-top: 1px solid var(--outline);
    padding-top: 16px;
    color: var(--primary);
    font-size: 1.12rem;
    font-weight: 900;
  }

  .checkout {
    width: 100%;
    background: var(--whatsapp);
    color: white;
  }

  .checkout.disabled {
    pointer-events: none;
    filter: grayscale(1);
  }

  .clear-cart {
    min-height: 42px;
    border: 1px solid var(--outline);
    border-radius: 999px;
    background: white;
    color: var(--primary);
    cursor: pointer;
    font-weight: 900;
  }

  @media (max-width: 900px) {
    .cart {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .cart-item {
      grid-template-columns: 90px minmax(0, 1fr);
    }

    .cart-item img {
      width: 90px;
      height: 90px;
    }

    .cart-item button {
      grid-column: 2;
      width: 100%;
      border-radius: 999px;
    }
  }
</style>
