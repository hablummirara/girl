---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ProductCard from "../components/ProductCard.astro";
import { bestSellers } from "../data/products";
---

<Layout>
  <Navbar />
  <main class="page">
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Your Digital Bestie</span>
          <h1 class="title-xl">Teman belanja cewek yang ngerti apa yang kamu butuhin</h1>
          <p class="lead">Temukan koleksi fashion, makeup, aksesori, dan self care yang dikurasi dengan rasa personal untuk hari yang lebih joyful.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/products">Belanja Sekarang</a>
            <a class="btn btn-outline" href="#best-sellers">Lihat Koleksi</a>
          </div>
        </div>
        <div class="hero-media" aria-label="Koleksi pilihan Girl Collection">
          <img src={bestSellers[0].img} alt="Lavender Cloud Cardigan" />
        </div>
      </div>
    </section>

    <section class="section soft" id="best-sellers">
      <div class="container">
        <div class="section-head">
          <div>
            <h2 class="title-md">Best Sellers</h2>
            <p class="lead">Yang lagi banyak diincar cewek-cewek hits.</p>
          </div>
          <a href="/products">Lihat Semua</a>
        </div>
        <div class="grid-products">
          {bestSellers.map((product) => <ProductCard product={product} />)}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container value-grid">
        <article>
          <span class="material-symbols-outlined">local_shipping</span>
          <h3>Fast Order</h3>
          <p>Checkout diarahkan ke WhatsApp supaya proses pemesanan cepat dan mudah.</p>
        </article>
        <article>
          <span class="material-symbols-outlined">verified</span>
          <h3>Curated Items</h3>
          <p>Produk dipilih agar cocok untuk gaya sehari-hari, hadiah, atau self reward.</p>
        </article>
        <article>
          <span class="material-symbols-outlined">support_agent</span>
          <h3>Friendly Support</h3>
          <p>Tim Girl Collection siap membantu detail ukuran, stok, dan pengiriman.</p>
        </article>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .hero {
    min-height: calc(100vh - 88px);
    display: grid;
    align-items: center;
    padding-block: 56px;
    background:
      radial-gradient(circle at 90% 20%, rgba(111, 81, 142, 0.22), transparent 28%),
      linear-gradient(135deg, var(--primary-soft), var(--secondary-soft));
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
    align-items: center;
    gap: clamp(28px, 6vw, 76px);
  }

  .hero-copy {
    display: grid;
    gap: 22px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-media {
    position: relative;
    overflow: hidden;
    border: 12px solid rgba(255, 255, 255, 0.72);
    border-radius: 28px;
    aspect-ratio: 4 / 5;
    background: var(--surface-high);
    box-shadow: var(--shadow);
    animation: float 4s ease-in-out infinite;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .soft {
    background: var(--surface-low);
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
  }

  .section-head a {
    color: var(--primary);
    font-weight: 900;
    text-decoration: underline;
  }

  .value-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .value-grid article {
    border: 1px solid rgba(220, 191, 198, 0.8);
    border-radius: var(--radius);
    background: white;
    padding: 24px;
    box-shadow: 0 18px 48px -42px rgba(170, 44, 98, 0.7);
  }

  .value-grid span {
    color: var(--primary);
    font-size: 34px;
  }

  .value-grid h3 {
    margin: 14px 0 6px;
    font-family: "Plus Jakarta Sans", sans-serif;
  }

  .value-grid p {
    margin: 0;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .hero-grid,
    .value-grid {
      grid-template-columns: 1fr;
    }

    .hero-media {
      max-height: 520px;
    }
  }

  @media (max-width: 560px) {
    .hero-actions,
    .section-head {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
