---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { products } from "../data/products";
---

<Layout title="About | Girl Collection">
  <Navbar />
  <main class="page">
    <section class="container about">
      <div class="copy">
        <span class="eyebrow">Our Story</span>
        <h1 class="title-lg">About Girl Collection</h1>
        <p class="lead">Kami percaya setiap wanita berhak punya teman belanja yang selalu mendukung langkahnya. Bukan sekadar toko, Girl Collection hadir sebagai digital best friend yang mengerti kebutuhanmu.</p>
        <p>Berawal dari keinginan untuk menyederhanakan cara berbelanja dan merawat diri, kami mengkurasi setiap produk dengan sentuhan personal, warna yang lembut, dan kualitas yang nyaman dipakai.</p>
        <div class="stats">
          <strong>8+</strong><span>Produk kurasi</span>
          <strong>4</strong><span>Kategori utama</span>
          <strong>24/7</strong><span>Order via WhatsApp</span>
        </div>
      </div>
      <div class="photo">
        <img src={products[4].img} alt="Sunday Picnic Dress" />
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    align-items: center;
    gap: clamp(34px, 7vw, 84px);
    padding-block: clamp(56px, 9vw, 110px);
  }

  .copy {
    display: grid;
    gap: 18px;
  }

  .copy p:not(.lead) {
    margin: 0;
    color: var(--muted);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin-top: 8px;
  }

  .stats strong,
  .stats span {
    display: block;
  }

  .stats strong {
    color: var(--primary);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1.6rem;
  }

  .stats span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .photo {
    overflow: hidden;
    border: 12px solid rgba(255, 255, 255, 0.75);
    border-radius: 28px;
    aspect-ratio: 4 / 5;
    background: var(--surface-high);
    box-shadow: var(--shadow);
    transform: rotate(1.5deg);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 820px) {
    .about {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .stats {
      grid-template-columns: 1fr;
    }
  }
</style>
