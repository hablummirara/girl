---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/products", label: "Products" },
  { href: "/about", label: "About" },
  { href: "/faq", label: "FAQ" },
];

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="site-header">
  <nav class="nav container" aria-label="Navigasi utama">
    <a class="brand" href="/">
      <span class="brand-mark">GC</span>
      <span>Girl Collection</span>
    </a>

    <div class="nav-links" data-nav-links>
      {navItems.map((item) => (
        <a class:list={["nav-link", path === item.href && "active"]} href={item.href}>{item.label}</a>
      ))}
    </div>

    <div class="nav-actions">
      <a class="icon-link" href="/products" aria-label="Cari produk">
        <span class="material-symbols-outlined">search</span>
      </a>
      <a class="cart-link" href="/cart" aria-label="Keranjang belanja">
        <span class="material-symbols-outlined">shopping_cart</span>
        <span data-cart-count class="is-empty">0</span>
      </a>
      <button class="menu-toggle" type="button" aria-label="Buka menu" aria-expanded="false" data-menu-toggle>
        <span class="material-symbols-outlined">menu</span>
      </button>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector("[data-menu-toggle]");
  const links = document.querySelector("[data-nav-links]");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
    links?.classList.toggle("open", !isOpen);
    document.body.classList.toggle("menu-open", !isOpen);
  });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    border-bottom: 1px solid rgba(220, 191, 198, 0.55);
    background: rgba(255, 248, 248, 0.84);
    backdrop-filter: blur(16px);
    box-shadow: 0 18px 46px -38px rgba(170, 44, 98, 0.8);
  }

  .nav {
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--primary);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 1.2rem;
    font-weight: 800;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--primary-soft), var(--secondary-soft));
    box-shadow: inset 0 0 0 1px rgba(170, 44, 98, 0.12);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .nav-link {
    color: var(--muted);
    font-family: "Plus Jakarta Sans", sans-serif;
    font-size: 0.88rem;
    font-weight: 800;
  }

  .nav-link.active,
  .nav-link:hover {
    color: var(--primary);
  }

  .nav-actions {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }

  .icon-link,
  .cart-link,
  .menu-toggle {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--primary);
    cursor: pointer;
  }

  .cart-link {
    position: relative;
  }

  .cart-link > span:last-child {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    width: 19px;
    height: 19px;
    place-items: center;
    border: 2px solid var(--surface);
    border-radius: 50%;
    background: var(--primary-bright);
    color: white;
    font-size: 0.66rem;
    font-weight: 800;
  }

  .cart-link > span:last-child.is-empty {
    display: none;
  }

  .menu-toggle {
    display: none;
  }

  @media (max-width: 760px) {
    .nav {
      min-height: 68px;
    }

    .brand span:last-child {
      display: none;
    }

    .menu-toggle {
      display: grid;
    }

    .nav-links {
      position: fixed;
      inset: 68px 0 auto;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      border-bottom: 1px solid var(--outline);
      background: var(--surface);
      padding: 12px 20px 20px;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-link {
      padding: 14px 4px;
    }
  }
</style>
